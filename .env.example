# Application
APP_PORT=8080
APP_ENV=development

# Database — either set DATABASE_URL directly...
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/user_age_api?sslmode=disable

# ...or set the individual parts (used only when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=user_age_api
DB_SSLMODE=disable
